{
  "name": "vite-plugin-docs-resolver",
  "version": "0.1.1",
  "description": "Vite plugin to resolve and extract code documentation from TypeScript and JavaScript modules",
  "license": "Apache-2.0",
  "author": "Anis Oseryx <anis.oseryx@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fennec-Corporation/vite-plugin-docs-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/Fennec-Corporation/vite-plugin-docs-resolver/issues"
  },
  "homepage": "https://github.com/Fennec-Corporation/vite-plugin-docs-resolver#readme",
  "keywords": [
    "vite",
    "vite-plugin",
    "docs",
    "documentation",
    "typescript",
    "jsdoc",
    "ast",
    "extractor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE.txt"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:plugin": "tsup",
    "dev:plugin": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "example:dev": "pnpm --filter @example/doc dev",
    "example:build": "pnpm --filter @example/doc build"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "doctrine": "^3.0.0",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/babel__traverse": "^7.20.6",
    "@types/doctrine": "^0.0.9",
    "@types/node": "^22.13.9",
    "@types/picomatch": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
