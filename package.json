{
  "name": "vite-plugin-docs-resolver",
  "version": "0.1.0",
  "description": "Vite plugin to resolve and extract code documentation from TypeScript and JavaScript modules",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:plugin": "tsup",
    "dev:plugin": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:dev": "pnpm --filter @example/doc dev",
    "example:build": "pnpm --filter @example/doc build"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "doctrine": "^3.0.0",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/doctrine": "^0.0.9",
    "@types/node": "^22.13.9",
    "@types/picomatch": "^3.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}